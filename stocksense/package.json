{
  "name": "stocksense",
  "version": "1.0.0",
  "description": "StockSense inventory management",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build --outDir dist/client",
    "start": "node dist/server/start.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke.mjs",
    "test:security": "node tests/security.mjs",
    "test:production": "node tests/production.mjs",
    "test": "npm run smoke && npm run test:security && npm run test:production",
    "check": "npm run typecheck && npm run build && npm test && npm run test:browser",
    "demo:reset": "tsx src/server/reset-demo.ts",
    "db:migrate": "node dist/server/migrate.js",
    "company:bootstrap": "node dist/server/bootstrap.js",
    "test:browser": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
