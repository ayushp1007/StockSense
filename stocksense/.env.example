NODE_ENV=development
APP_ENV=demo
PORT=4000
DB_PATH=./data/stocksense.db
# On Vercel, connect a Turso database. These values must remain server-only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Use a unique random value (at least 32 characters) in production.
JWT_SECRET=

# Public HTTPS origin in production, e.g. https://inventory.example.com.
# Leave empty for local development. Browser write requests must match this origin.
APP_ORIGIN=

# Optional. Without this, the copilot uses transparent rule-based answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Password reset email via Resend. In production, configure both values or the reset
# endpoint tells users to contact an administrator. Only local demo mode shows a code.
RESEND_API_KEY=
EMAIL_FROM=StockSense <no-reply@example.com>

# Set true only when deployed behind one trusted reverse proxy.
TRUST_PROXY=false
